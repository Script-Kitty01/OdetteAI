{
  "name": "cwru-anomaly-baseline",
  "kind": "cwru-anomaly",
  "seed": 42,
  "raw_dir": "data/raw/cwru",
  "output_root": "models/runs",
  "train_fraction": 0.7,
  "validation_fraction": 0.15,
  "signal": {
    "sampling_rate_hz": 12000.0,
